{
  "$schema": "vscode://schemas/color-theme",
  "name": "Neonferatu Phosphor",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#008C3F",
    "class": {
      "foreground": "#008C3F",
      "bold": true
    },
    "interface": "#33AF5B",
    "struct": "#008C3F",
    "enum": "#008C3F",
    "enumMember": "#FFB000",
    "type": "#008C3F",
    "typeParameter": {
      "foreground": "#33AF5B",
      "italic": true
    },
    "function": {
      "foreground": "#00D965",
      "bold": true
    },
    "method": {
      "foreground": "#00D965",
      "bold": true
    },
    "macro": {
      "foreground": "#FFD8A0",
      "italic": true
    },
    "property": "#5FFB8D",
    "parameter": {
      "foreground": "#5BC175",
      "italic": true
    },
    "variable": "#9CF3AE",
    "variable.readonly": "#FFB000",
    "variable.defaultLibrary": {
      "foreground": "#008C3F",
      "italic": true
    },
    "keyword": {
      "foreground": "#FF3A8B",
      "bold": true
    },
    "string": "#3AFF81",
    "number": "#FFB000",
    "comment": {
      "foreground": "#46935A",
      "italic": true
    },
    "operator": "#FF84AA",
    "*.deprecated": {
      "strikethrough": true
    }
  },
