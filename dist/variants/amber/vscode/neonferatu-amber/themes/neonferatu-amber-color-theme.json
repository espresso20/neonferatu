{
  "$schema": "vscode://schemas/color-theme",
  "name": "Neonferatu Amber",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#BE8400",
    "class": {
      "foreground": "#BE8400",
      "bold": true
    },
    "interface": "#D59C34",
    "struct": "#BE8400",
    "enum": "#BE8400",
    "enumMember": "#A17000",
    "type": "#BE8400",
    "typeParameter": {
      "foreground": "#D59C34",
      "italic": true
    },
    "function": {
      "foreground": "#FAAF00",
      "bold": true
    },
    "method": {
      "foreground": "#FAAF00",
      "bold": true
    },
    "macro": {
      "foreground": "#B98627",
      "italic": true
    },
    "property": "#FAD08F",
    "parameter": {
      "foreground": "#CD9F52",
      "italic": true
    },
    "variable": "#F1D7AE",
    "variable.readonly": "#A17000",
    "variable.defaultLibrary": {
      "foreground": "#BE8400",
      "italic": true
    },
    "keyword": {
      "foreground": "#FF3A8B",
      "bold": true
    },
    "string": "#FFCF83",
    "number": "#A17000",
    "comment": {
      "foreground": "#9D7940",
      "italic": true
    },
    "operator": "#FF84AA",
    "*.deprecated": {
      "strikethrough": true
    }
  },
