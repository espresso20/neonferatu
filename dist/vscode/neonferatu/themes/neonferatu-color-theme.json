{
  "$schema": "vscode://schemas/color-theme",
  "name": "Neonferatu",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#B767FC",
    "class": {
      "foreground": "#B767FC",
      "bold": true
    },
    "interface": "#CA94FF",
    "struct": "#B767FC",
    "enum": "#B767FC",
    "enumMember": "#FCB100",
    "type": "#B767FC",
    "typeParameter": {
      "foreground": "#CA94FF",
      "italic": true
    },
    "function": {
      "foreground": "#00D5EE",
      "bold": true
    },
    "method": {
      "foreground": "#00D5EE",
      "bold": true
    },
    "macro": {
      "foreground": "#FFD89B",
      "italic": true
    },
    "property": "#84EDFF",
    "parameter": {
      "foreground": "#A99FD6",
      "italic": true
    },
    "variable": "#E8E3FF",
    "variable.readonly": "#FCB100",
    "variable.defaultLibrary": {
      "foreground": "#B767FC",
      "italic": true
    },
    "keyword": {
      "foreground": "#FF3A8B",
      "bold": true
    },
    "string": "#87E11D",
    "number": "#FCB100",
    "comment": {
      "foreground": "#7971A5",
      "italic": true
    },
    "operator": "#FF84AA",
    "*.deprecated": {
      "strikethrough": true
    }
  },
